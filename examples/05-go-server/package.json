{
  "name": "@socket-rpc/rpc",
  "version": "1.0.0",
  "description": "Auto-generated RPC package for Socket.IO",
  "type": "module",
  "main": "./dist/types.generated.js",
  "types": "./dist/types.generated.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.generated.d.ts",
      "default": "./dist/types.generated.js"
